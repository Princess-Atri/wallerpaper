<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WebWallpaperHost</AssemblyName>
    <RootNamespace>WebWallpaperHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\WorkerWRuntime\WorkerWRuntime.csproj" />
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>lib\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="lib\WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" Link="WebView2Loader.dll" />
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="wwwroot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Wallerpaper.Diagnostics\Wallerpaper.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="9.0.9" />
    <PackageReference Include="System.Text.Json" Version="9.0.9" />
  </ItemGroup>

</Project>
