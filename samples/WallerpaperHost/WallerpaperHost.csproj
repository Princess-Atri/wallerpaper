<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WallerpaperHost</AssemblyName>
    <RootNamespace>Wallerpaper.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="scheduler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fallback.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Wallerpaper.Diagnostics\Wallerpaper.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="9.0.9" />
    <PackageReference Include="System.Text.Json" Version="9.0.9" />
  </ItemGroup>

</Project>
