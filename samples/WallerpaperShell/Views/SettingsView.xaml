<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wallerpaper.Shell.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wallerpaper.Shell.Models">

    <ScrollViewer>
        <StackPanel Padding="24,18,28,32" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="性能、启动、多显示器与缓存。所有设置保存到 shell-config.json。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Border Padding="20" CornerRadius="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="性能策略" FontSize="18" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="PolicyCombo" Header="全屏时" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="继续渲染" Tag="continue"/>
                            <ComboBoxItem Content="暂停并保留显存" Tag="pause"/>
                            <ComboBoxItem Content="停止并释放进程" Tag="stop"/>
                        </ComboBox>
                        <ToggleSwitch x:Name="MaximizedToggle" Grid.Column="1"
                                      Header="最大化窗口也触发策略"/>
                        <NumberBox x:Name="AcFpsBox" Header="交流电 FPS" Minimum="24" Maximum="120"
                                   SpinButtonPlacementMode="Compact" Grid.Row="1"/>
                        <NumberBox x:Name="BatteryFpsBox" Header="电池 FPS" Minimum="24" Maximum="120"
                                   SpinButtonPlacementMode="Compact" Grid.Row="1" Grid.Column="1"/>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="TextureMemoryBox" Header="贴图显存上限 MB"
                                   Minimum="64" Maximum="8192" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="ParticlesBox" Header="最大粒子数" Grid.Column="1"
                                   Minimum="0" Maximum="4096" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="渲染缩放"/>
                        <Slider x:Name="RenderScaleSlider" Minimum="0.5" Maximum="2"
                                StepFrequency="0.05" ValueChanged="RenderScale_Changed"/>
                        <TextBlock x:Name="RenderScaleValue" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="启动与托盘" FontSize="18" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="AutostartToggle" Header="随 Windows 启动"/>
                    <ToggleSwitch x:Name="MinimizeToggle" Header="关闭主窗口时最小化到系统托盘"/>
                    <TextBlock Text="自启动写入 HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run，无需管理员权限。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="多显示器壁纸分配" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="每块显示器独立选择壁纸；未指定时使用当前选中壁纸。"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel x:Name="MonitorAssignmentsPanel" Spacing="8"/>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="缓存与资源限制" FontSize="18" FontWeight="SemiBold"/>
                    <TextBox x:Name="CacheDirectoryBox" Header="缩略图缓存目录"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="CacheSizeBox" Header="缓存上限 MB"
                                   Minimum="64" Maximum="32768" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="ThumbWidthBox" Header="缩略图宽" Grid.Column="1"
                                   Minimum="160" Maximum="1280" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="ThumbHeightBox" Header="缩略图高" Grid.Column="2"
                                   Minimum="90" Maximum="720" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开缓存目录" Click="OpenCache_Click"/>
                        <Button Content="清空缩略图缓存" Click="ClearCache_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="播放规则" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="删除正在播放的壁纸时，系统应该怎么做。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="DeleteBehaviorCombo"
                              Header="删除当前壁纸后"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="继续播放上一个壁纸" Tag="previous"/>
                        <ComboBoxItem Content="播放壁纸库第一个壁纸" Tag="first"/>
                        <ComboBoxItem Content="暂停并恢复桌面壁纸" Tag="pause"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="预览" FontSize="18" FontWeight="SemiBold"/>
                    <Border Height="190" CornerRadius="8" Background="#141A24"
                            HorizontalAlignment="Stretch">
                        <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="PreviewHint" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="预览在设置页内显示，不会触碰真实桌面。视频请使用主界面的“预览”窗口。"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource AccentButtonStyle}"
                        Click="Save_Click"/>
                <Button Content="恢复默认" Click="Reset_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
