<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wallerpaper.Shell.Views.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="预览">
    <Grid Background="#0B0E14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True"
                                AutoPlay="True" Stretch="Uniform"/>
        </Grid>

        <Border Grid.Row="1" Padding="12,8" Background="#CC111722">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HintText" FontSize="12" Foreground="#AAB6C8"/>
                </StackPanel>
                <Button Grid.Column="1" Content="关闭" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
