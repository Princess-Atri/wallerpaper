<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wallerpaper.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wallerpaper.Shell.Models"
    xmlns:views="using:Wallerpaper.Shell.Views"
    Title="Wallerpaper">

    <Grid  x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ItemsPanelTemplate x:Key="DefaultGridPanel">
                <ItemsWrapGrid Orientation="Horizontal"/>
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="SceneGridPanel">
                <ItemsWrapGrid Orientation="Horizontal"
                               MaximumRowsOrColumns="3"
                               HorizontalAlignment="Left"/>
            </ItemsPanelTemplate>
            <DataTemplate x:Key="SceneCardTemplate" x:DataType="models:WallpaperItem">
                <Grid  Width="216" Height="190" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="10" Background="#182030"
                            BorderThickness="1" BorderBrush="#2A3446">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                               DoubleTapped="WallpaperImage_DoubleTapped"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind Title, Mode=OneWay}"
                               DoubleTapped="WallpaperTitle_DoubleTapped"
                               Margin="4,8,4,2"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold"
                                                                                      />
                </Grid>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="DeleteGridPanel">
                <ItemsWrapGrid Orientation="Horizontal"
                               MaximumRowsOrColumns="3"
                               HorizontalAlignment="Left"/>
            </ItemsPanelTemplate>
            <DataTemplate x:Key="DeleteCardTemplate" x:DataType="models:WallpaperItem">
                <Grid  Width="160" Height="132" Margin="4"
                                                                             >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="98"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="8" Background="#182030"
                            BorderThickness="1" BorderBrush="#2A3446">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind Title, Mode=OneWay}"
                               Margin="4,6,4,2"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid  x:Name="TitleBar" Height="48" Padding="16,0,8,0"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE7F4;" FontSize="18"/>
                <TextBlock Text="WALLERPAPER" FontWeight="SemiBold" CharacterSpacing="120"/>
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10" Padding="8,2">
                    <TextBlock Text="BETA" FontSize="10" Foreground="White"/>
                </Border>
            </StackPanel>

            <AutoSuggestBox TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" x:Name="SearchBox" Grid.Column="1" Width="360"
                            PlaceholderText="搜索壁纸名字"
                                                               
                                                                     
                            AutomationProperties.Name="搜索壁纸名字"
                            Margin="24,0" HorizontalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Click="AddFolder_Click" x:Name="AddFolderButton"                        
                        AutomationProperties.Name="添加文件夹"
                        ToolTipService.ToolTip="添加文件夹内所有视频">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14"/>
                        <TextBlock Text="添加文件夹"/>
                    </StackPanel>
                </Button>
                <Button Click="AddFile_Click" x:Name="AddFileButton"                      
                        AutomationProperties.Name="添加单个壁纸"
                        ToolTipService.ToolTip="添加单个壁纸文件">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                        <TextBlock Text="添加文件"/>
                    </StackPanel>
                </Button>
                <Button Click="AddSequence_Click" x:Name="AddSequenceButton"                          
                        AutomationProperties.Name="添加组合"
                        ToolTipService.ToolTip="添加两个视频：第一个播放一遍，第二个循环">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8AB;" FontSize="14"/>
                        <TextBlock Text="添加组合"/>
                    </StackPanel>
                </Button>
                <Button Click="VideoToWeb_Click" x:Name="VideoToWebButton"                         
                        Visibility="Collapsed"
                        AutomationProperties.Name="视频转换为Web"
                        ToolTipService.ToolTip="把视频库里的视频无损包装为 Web 壁纸">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="14"/>
                        <TextBlock Text="视频转 Web"/>
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click" x:Name="RefreshButton"                      
                        AutomationProperties.Name="刷新目录"
                        ToolTipService.ToolTip="刷新目录">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView SelectionChanged="Nav_SelectionChanged" x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                                                               >
            <NavigationView.MenuItems>
                <NavigationViewItem Content="动态" Tag="Video">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Video"/></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="全部壁纸" Tag="Video|All"/>
                        <NavigationViewItem Content="收藏" Tag="Video|Fav"/>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="静态" Tag="Static">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures"/></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="全部壁纸" Tag="Static|All"/>
                        <NavigationViewItem Content="收藏" Tag="Static|Fav"/>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="Web" Tag="Web">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World"/></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="全部壁纸" Tag="Web|All"/>
                        <NavigationViewItem Content="收藏" Tag="Web|Fav"/>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="场景" Tag="Scene">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="全部壁纸" Tag="Scene|All"/>
                        <NavigationViewItem Content="收藏" Tag="Scene|Fav"/>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="组合" Tag="Sequence">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;"/></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="全部壁纸" Tag="Sequence|All"/>
                        <NavigationViewItem Content="收藏" Tag="Sequence|Fav"/>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="回收站" Tag="Recycle">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Delete"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="超分" Tag="SuperResolution">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI 补帧" Tag="AiInterpolation">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tapped="PauseNavItem_Tapped" x:Name="PauseNavItem"
                                    Tag="Pause"
                                    SelectsOnInvoked="False"
                                                                
                                    Background="Transparent"
                                    Padding="0"
                                    Margin="12,0,12,80"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="暂停所有壁纸"
                                    ToolTipService.ToolTip="暂停或恢复所有壁纸">
                    <NavigationViewItem.Resources>
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#22FFFFFF"/>
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#33FFFFFF"/>
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent"/>
                    </NavigationViewItem.Resources>
                    <Border Background="#40FFFFFF"
                            BorderBrush="#66000000"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,6"
                            MinHeight="36">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon  x:Name="PauseIcon" Glyph="&#xE769;" FontSize="16"/>
                            <TextBlock  x:Name="PauseLabel" Text="暂停" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <!-- Library -->
                <Grid  x:Name="LibraryContent" Padding="24,18,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock  x:Name="CategoryTitle" Text="视频壁纸"
                                       FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock  x:Name="CategorySubtitle"
                                       Text="从文件夹读取的视频，双击应用到当前显示器"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="FavoriteFilterCombo" Width="132"
                                      Margin="0,6,0,0" SelectedIndex="0"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="FavoriteFilterCombo_SelectionChanged">
                                <ComboBoxItem Content="全部壁纸"/>
                                <ComboBoxItem Content="收藏"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Click="Apply_Click" x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}"
                                                        IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock Text="应用壁纸"/>
                                </StackPanel>
                            </Button>
                            <Button Click="Preview_Click" x:Name="PreviewButton"                       IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7B8;" FontSize="14"/>
                                    <TextBlock Text="预览"/>
                                </StackPanel>
                            </Button>
                            <Button Click="CreateWebPage_Click" x:Name="CreateWebButton"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="新建 Web 壁纸"
                                    ToolTipService.ToolTip="新建一个 HTML 动态页面壁纸">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE774;" FontSize="14"/>
                                    <TextBlock Text="新建 Web 页面"/>
                                </StackPanel>
                            </Button>
                            <Button Click="CreateScene_Click" x:Name="CreateSceneButton"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="新建场景壁纸"
                                    ToolTipService.ToolTip="新建一个图层/粒子组合的场景壁纸">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                                    <TextBlock Text="新建场景"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OpenDetail_Click" x:Name="OpenDetailButton"
                                    IsEnabled="False"
                                    AutomationProperties.Name="打开壁纸详情">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                    <TextBlock Text="详情"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ConvertToSequence_Click" x:Name="ConvertToSequenceButton"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="组合类视频转换"
                                    ToolTipService.ToolTip="选择两个视频生成组合壁纸">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="14"/>
                                    <TextBlock Text="组合类视频转换"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ConvertToMp4_Click" x:Name="ConvertToMp4Button"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="转换为 MP4"
                                    ToolTipService.ToolTip="将当前视频或组合壁纸转换为独立的 MP4 文件">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE898;" FontSize="14"/>
                                    <TextBlock Text="转为 MP4"/>
                                </StackPanel>
                            </Button>
                            <Button Click="DeleteSelected_Click" x:Name="DeleteSelectedButton"
                                    IsEnabled="False"
                                    AutomationProperties.Name="删除当前选中的壁纸">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="删除"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BatchDelete_Click" x:Name="BatchDeleteButton"
                                    AutomationProperties.Name="批量删除壁纸">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="批量删除"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock  x:Name="StatusText" Grid.Row="1" Margin="0,48,0,0"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <GridView DragOver="WallpaperGrid_DragOver" Drop="WallpaperGrid_Drop" ItemClick="WallpaperGrid_ItemClick" DoubleTapped="WallpaperGrid_DoubleTapped" SelectionChanged="WallpaperGrid_SelectionChanged" PointerWheelChanged="WallpaperGrid_PointerWheelChanged" x:Name="WallpaperGrid" Grid.Row="2"
                                  AllowDrop="True"
                                                                   
                                                           
                                  IsItemClickEnabled="True"
                                  SelectionMode="Single"
                                                                     
                                                                           
                                                                                   
                                  ScrollViewer.VerticalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.IsVerticalScrollChainingEnabled="True"
                                  ScrollViewer.HorizontalScrollMode="Disabled">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:WallpaperItem">
                                    <Grid  Width="236" Height="162" Margin="4"
                                                                                                 
                                                                                       >
                                        <Border CornerRadius="10" Background="#182030"
                                                BorderThickness="1" BorderBrush="#2A3446">
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                   DoubleTapped="WallpaperImage_DoubleTapped"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <Border VerticalAlignment="Bottom" Height="52"
                                                CornerRadius="0,0,10,10">
                                            <Border.Background>
                                                <AcrylicBrush TintColor="#FFFFFF"
                                                              TintOpacity="0.45"
                                                              FallbackColor="#B8FFFFFF"/>
                                            </Border.Background>
                                            <StackPanel Margin="12,4" Spacing="2">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           DoubleTapped="WallpaperTitle_DoubleTapped"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E610151F"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Kind}"
                                                           FontSize="11"
                                                           Foreground="#B310151F"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock  x:Name="EmptyState" Grid.Row="2"
                                   Text="还没有壁纸。点击右上角“添加文件夹”，或把素材放进配置的目录。"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="420"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                </Grid>


                <!-- Wallpaper detail page -->
                <Grid  x:Name="DetailPage" Visibility="Collapsed" Padding="24,18,20,20"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Click="DetailBack_Click" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                                        
                                AutomationProperties.Name="返回壁纸列表"
                                ToolTipService.ToolTip="返回壁纸列表"/>
                        <TextBlock Text="壁纸详情" FontSize="26" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="12" Background="#10151F"
                                    BorderThickness="1" BorderBrush="#2A3446">
                                <Grid>
                                    <Image  x:Name="DetailPreviewImage" Stretch="Uniform"/>
                                    <MediaPlayerElement  x:Name="DetailPlayer"
                                                        Visibility="Collapsed"
                                                        AreTransportControlsEnabled="False"
                                                        AutoPlay="False"
                                                        Stretch="Uniform"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="4,12,4,0" Spacing="4">
                                <TextBlock  x:Name="DetailTitleText" FontSize="22"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock  x:Name="DetailKindText" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock  x:Name="DetailPathText" FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" Padding="20"
                                CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <ScrollViewer>
                                <StackPanel Spacing="16">
                                    <TextBlock Text="属性" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock  x:Name="PropertyTitle" Text="未选择壁纸"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <Button Click="ApplyDetail_Click" Content="应用壁纸"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="应用当前壁纸"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="Rename_Click" x:Name="RenameButton" Content="重命名"
                                                                     IsEnabled="False"
                                                AutomationProperties.Name="重命名壁纸"/>
                                        <Button Click="Delete_Click" x:Name="DeleteButton"
                                                                     IsEnabled="False"
                                                AutomationProperties.Name="删除壁纸">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                <TextBlock Text="删除壁纸"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Button Click="AdvancedFeatures_Click" Content="高级功能与前提"
                                                                          
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="高级功能与前提"/>
                                    <StackPanel  x:Name="VideoInfoPanel" Spacing="4">
                                        <TextBlock Text="视频播放属性" FontWeight="SemiBold"/>
                                        <TextBlock Text="支持帧率、AI 插帧、播放速度和音量。"
                                                   TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Click="TrimVideo_Click" x:Name="TrimVideoButton" Content="裁剪时长"
                                                                       
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="裁剪时长"/>
                                        <TextBlock Text="按时间裁剪，生成一个新视频并加入库。"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Click="CropVideo_Click" x:Name="CropVideoButton" Content="裁剪画面"
                                                                       
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="裁剪画面"/>
                                        <TextBlock Text="裁掉上/下/左/右边缘，改变画面尺寸，生成新视频。"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Click="AutoCrop_Click" x:Name="AutoCropButton" Content="自动去黑边"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="自动检测并去除黑边"/>
                                        <TextBlock Text="自动检测大面积黑边，只裁掉黑边，无损生成新视频。"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel  x:Name="StaticInfoPanel" Spacing="4" Visibility="Collapsed">
                                        <TextBlock Text="静态画面属性" FontWeight="SemiBold"/>
                                        <TextBlock Text="支持画面调节、RGB 曲线和图片超分。"
                                                   TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Content="画面调节与 RGB 曲线"
                                                Click="StaticAdjust_Click"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Content="静态图片超分"
                                                Click="StaticUpscale_Click"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel  x:Name="SequenceInfoPanel" Spacing="4" Visibility="Collapsed">
                                        <TextBlock Text="组合播放属性" FontWeight="SemiBold"/>
                                        <TextBlock Text="第一个视频播放一遍，第二个视频循环播放。"
                                                   TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock  x:Name="SequencePathText" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Click="EditQueue_Click" Content="编辑播放队列"
                                                                       
                                                HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="队列可裁剪每条视频，生成一个硬切拼接视频；整个视频循环播放。"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel  x:Name="WebInfoPanel" Spacing="8" Visibility="Collapsed">
                                        <TextBlock Text="Web 页面属性" FontWeight="SemiBold"/>
                                        <TextBlock Text="由 WebView2 渲染本地 HTML 页面；页面内的动画和交互由该网页自身控制。"
                                                   TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="建议使用 H.264 或 VP9 视频，兼容性最好。"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Grid>
                                            <TextBlock Text="页面缩放"/>
                                            <TextBlock  x:Name="WebZoomValue" Text="100%"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <Slider ValueChanged="WebZoomSlider_ValueChanged" x:Name="WebZoomSlider" Minimum="0.5" Maximum="2"
                                                StepFrequency="0.05"
                                                AutomationProperties.Name="页面缩放"
                                                                                         />
                                        <Button Click="ApplyWebZoom_Click" Content="应用页面缩放"
                                                                          
                                                HorizontalAlignment="Stretch"/>
                                        <Button Click="ReloadWeb_Click" Content="刷新 Web 页面"
                                                                       
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel  x:Name="SceneInfoPanel" Spacing="8" Visibility="Collapsed">
                                        <TextBlock Text="场景属性" FontWeight="SemiBold"/>
                                        <TextBlock Text="由 SceneWallpaperHost 渲染 2D 图层和 Shader。"
                                                   TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox SelectionChanged="SceneQualityCombo_SelectionChanged" x:Name="SceneQualityCombo" Header="渲染质量"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="场景渲染质量"
                                                                                                       >
                                            <ComboBoxItem Content="流畅（0.5×）" Tag="0.5"/>
                                            <ComboBoxItem Content="标准（1×）" Tag="1"/>
                                            <ComboBoxItem Content="高清（1.5×）" Tag="1.5"/>
                                            <ComboBoxItem Content="超采样（2×）" Tag="2"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel  x:Name="AiPanel" Spacing="4">
                                        <Button Click="AiInterpolate_Click" x:Name="AiInterpolateButton" Content="AI 插帧"
                                                                           
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="AI插帧"/>
                                        <TextBlock Text="离线用 RIFE 生成高帧率副本；需要 FFmpeg/RIFE 工具，耗时长"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Click="SuperResolution_Click" x:Name="SuperResolutionButton"
                                                Content="超分辨率"
                                                                             
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="视频超分辨率"/>
                                        <TextBlock Text="Real-ESRGAN 逐帧放大；2× 已会生成很大的视频，耗时取决于显卡。"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel  x:Name="VolumePanel" Spacing="8">
                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <TextBlock Text="音量"/>
                                                <TextBlock  x:Name="VolumeValue" Text="0" HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Slider ValueChanged="VolumeSlider_ValueChanged" x:Name="VolumeSlider" Minimum="0" Maximum="100"
                                                    AutomationProperties.Name="音量"
                                                    AutomationProperties.HelpText="0 到 100"
                                                    StepFrequency="1"                                         />
                                        </StackPanel>
                                        <ToggleSwitch Toggled="MuteToggle_Toggled" x:Name="MuteToggle" Header="静音"
                                                      AutomationProperties.Name="静音"
                                                                                  />
                                    </StackPanel>

                                    <StackPanel  x:Name="FpsPanel" Spacing="4">
                                        <ComboBox SelectionChanged="VideoFitCombo_SelectionChanged" x:Name="VideoFitCombo" Header="画面填充"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="画面填充方式"
                                                                                                   >
                                            <ComboBoxItem Content="裁剪铺满" Tag="cover"/>
                                            <ComboBoxItem Content="完整显示" Tag="contain"/>
                                            <ComboBoxItem Content="模糊背景" Tag="blur"/>
                                        </ComboBox>
                                        <Grid>
                                            <TextBlock Text="源帧率"/>
                                            <TextBlock  x:Name="SourceFpsText" Text="播放时检测"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="输出帧率" VerticalAlignment="Center"/>
                                            <ComboBox SelectionChanged="TargetFpsCombo_SelectionChanged" x:Name="TargetFpsCombo"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="170"
                                                      AutomationProperties.Name="目标帧率"
                                                                                                        >
                                                <ComboBoxItem Content="自动（全局）" Tag="0"/>
                                                <ComboBoxItem Content="30 fps" Tag="30"/>
                                                <ComboBoxItem Content="60 fps" Tag="60"/>
                                                <ComboBoxItem Content="120 fps" Tag="120"/>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock  x:Name="FpsHintText" Text="补帧为帧复制，不生成新的运动信息"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel  x:Name="SpeedPanel" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="播放速度"/>
                                            <TextBlock  x:Name="SpeedValue" Text="1.0×" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <Slider ValueChanged="SpeedSlider_ValueChanged" x:Name="SpeedSlider" Minimum="0.1" Maximum="4"
                                                AutomationProperties.Name="播放速度"
                                                StepFrequency="0.1"                                        />
                                    </StackPanel>

                                    <StackPanel  x:Name="ShaderPanel" Spacing="4" Visibility="Collapsed">
                                        <Grid>
                                            <TextBlock Text="着色器强度"/>
                                            <TextBlock  x:Name="ShaderValue" Text="1.00" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <Slider ValueChanged="ShaderSlider_ValueChanged" x:Name="ShaderSlider" Minimum="0" Maximum="2"
                                                AutomationProperties.Name="着色器强度"
                                                StepFrequency="0.01"                                         />
                                    </StackPanel>

                                    <ComboBox  x:Name="TargetMonitorCombo" Header="目标显示器"
                                              AutomationProperties.Name="目标显示器"
                                              HorizontalAlignment="Stretch"/>

                                    <Button Click="ApplyToMonitor_Click" x:Name="ApplyToMonitorButton" Content="应用到目标显示器"
                                            HorizontalAlignment="Stretch"                             
                                            IsEnabled="False"/>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                                    <TextBlock Text="多显示器" FontWeight="SemiBold"/>
                                    <TextBlock Text="在“设置 → 多显示器”中为每块屏幕指定壁纸。"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <Button Click="RebuildThumb_Click" Content="生成缩略图"                           
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Settings -->
                <views:SettingsView  x:Name="SettingsViewControl" Visibility="Collapsed"/>
                <views:SuperResolutionView x:Name="SuperResolutionViewControl" Visibility="Collapsed"/>
                <views:AiInterpolationView x:Name="AiInterpolationViewControl" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>

