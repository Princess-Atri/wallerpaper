<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SceneWallpaperHost</AssemblyName>
    <RootNamespace>SceneWallpaperHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="9.0.9" />
    <PackageReference Include="System.Text.Json" Version="9.0.9" />
    <ProjectReference Include="..\Shared\WorkerWRuntime\WorkerWRuntime.csproj" />
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="QuickJS.NET" Version="0.0.3" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="scenes\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="scenes" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Wallerpaper.Diagnostics\Wallerpaper.Diagnostics.csproj" />
  </ItemGroup>

</Project>
